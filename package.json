{
  "name": "atlasnews",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build:next -w apps/web",
    "build:sites": "npm run build -w apps/web && npm run typegen -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "design:lint": "designmd lint --format json DESIGN.md",
    "design:tokens:write": "node scripts/design-tokens.mjs --write",
    "design:tokens:check": "node scripts/design-tokens.mjs",
    "plugin:check": "node scripts/validate-plugin.mjs",
    "plugin:release": "node scripts/validate-plugin.mjs --release",
    "perf:budget": "node scripts/performance-budget.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "supabase:start": "npx --no-install supabase start",
    "supabase:reset": "npx --no-install supabase db reset --local",
    "supabase:status": "npx --no-install supabase status",
    "check": "npm run design:lint && npm run design:tokens:check && npm run plugin:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run perf:budget && npm run build:sites"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "2.113.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
