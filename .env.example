# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (leave empty to use the built-in read/write demo repository)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional comma-separated browser origins allowed to call the MCP endpoint.
# Non-browser MCP clients usually omit Origin and remain supported.
MCP_ALLOWED_ORIGINS=http://localhost:3000
