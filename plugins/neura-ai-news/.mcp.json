{
  "mcpServers": {
    "neura-public": {
      "type": "http",
      "url": "http://localhost:8787/mcp"
    },
    "neura-admin": {
      "type": "http",
      "url": "http://localhost:8787/mcp/admin",
      "bearer_token_env_var": "NEURA_MCP_ADMIN_API_KEY",
      "headers": {
        "Authorization": "Bearer ${NEURA_MCP_ADMIN_API_KEY}"
      }
    }
  }
}
