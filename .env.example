# Canonical public origin. Absolute URL, no path. NEXT_PUBLIC_* values are
# embedded in browser bundles at build time, so set them before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content backend: sites, supabase or demo.
# - sites: ChatGPT Sites, the default deployment. Records live in the Site's D1
#   database (binding DB) and uploads in its R2 bucket (binding BUCKET), editors
#   sign in with ChatGPT. No Supabase. The Sites build (`pnpm build` in apps/web)
#   uses it when nothing else is set, and a present DB binding selects it at run time.
# - supabase: self-hosted on Supabase (Postgres, Storage, Auth) with apps/mcp and
#   apps/jobs as containers. See docs/DEPLOYMENT.md.
# - demo: in-memory seed data for local and CI review only.
# Empty picks it from what is present: a DB binding means sites, Supabase settings
# mean supabase, otherwise demo. Leave it empty on ChatGPT Sites.
ATLASNEWS_CONTENT_MODE=

# Sites only. Comma-separated ChatGPT account emails that become Studio admins, or
# editors, the first time they sign in with ChatGPT (each gets its own author). The
# account that signs in first owns the row. See docs/SITES.md.
ATLASNEWS_ADMIN_EMAILS=
ATLASNEWS_EDITOR_EMAILS=

# Sites and demo: sign in with Google and GitHub, next to ChatGPT, for editors and for readers who
# comment. A provider turns on when its id and secret are both set AND ATLASNEWS_SESSION_SECRET is
# set. Editors are matched by verified email, so one person can use any provider. Register the
# callback https://<site>/api/auth/google/callback with the Google OAuth client (type Web
# application) and https://<site>/api/auth/github/callback with the GitHub OAuth app. In
# supabase mode these are ignored: enable the providers in the Supabase dashboard instead and list
# them in ATLASNEWS_SUPABASE_OAUTH_PROVIDERS. See docs/SITES.md and docs/DEPLOYMENT.md.
# ATLASNEWS_SESSION_SECRET signs the sign-in cookies (minimum 32 characters).
# Generate with: openssl rand -hex 32
ATLASNEWS_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# supabase mode only: comma-separated providers (google, github) enabled in the Supabase project.
ATLASNEWS_SUPABASE_OAUTH_PROVIDERS=

# Supabase public credentials (supabase mode only). Leave BOTH empty otherwise. Set BOTH together
# with ATLASNEWS_CONTENT_MODE=supabase. The anon/publishable key is safe to expose
# only because Row Level Security is the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials used only after admin MCP authentication.
# The service role key also reads the editor's profile when an editor signs in to
# the MCP server. The author ID is the author of writes made with the API key only
# (a signed-in editor is attributed to their own author); it must reference
# public.authors. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ATLASNEWS_MCP_ADMIN_AUTHOR_ID=

# Server-only emergency opt-in for an intentionally ephemeral production Studio.
# Local development (NODE_ENV=development or test) enables demo Studio automatically.
# A runtime that sets no NODE_ENV does not. Keep this empty on normal Preview and
# Production deployments so missing Supabase configuration fails closed.
ATLASNEWS_ENABLE_DEMO_STUDIO=

# Optional official profiles. Invalid or empty URLs are omitted from the footer.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# Public origin of the MCP server, no path. On Sites the site serves /mcp itself and
# this stays empty (default: the site origin). Self-hosted it is the standalone server
# (apps/mcp): read by apps/web (the site footer links to it) and by apps/mcp (the
# `resource` in its OAuth metadata and Bearer challenges). Behind a proxy or CDN it MUST
# be the exact origin hosts were given, for example https://mcp.news.example.com.
# Default: the site origin in sites mode, otherwise http://localhost:8787
NEXT_PUBLIC_MCP_URL=

# Optional, read by apps/mcp only. Sign-in with Supabase Auth turns on by itself
# when NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are all set; these two override its defaults.
# Sign-in also needs NEXT_PUBLIC_MCP_URL (below). Without it the server offers no
# sign-in, because the resource URL in its challenges must not come from the
# request's Host header.
# Issuer when it differs from <supabase url>/auth/v1 (a Supabase custom domain).
ATLASNEWS_MCP_OAUTH_ISSUER=
# Required `aud` of access tokens. Empty accepts Supabase's `authenticated`; set it
# to the MCP URL (https://mcp.news.example.com/mcp) only once a custom access
# token hook issues that audience. See docs/MCP.md.
ATLASNEWS_MCP_OAUTH_AUDIENCE=

# Optional comma-separated OAuth client ids whose tokens apps/mcp accepts. Empty
# accepts every client of the Supabase project, which dynamic client registration
# needs and is NOT recommended in production: anyone can register a client and ask
# an editor to approve it. Set it after turning dynamic registration off and
# pre-registering the clients (see docs/MCP.md).
ATLASNEWS_MCP_OAUTH_CLIENT_IDS=

# Optional, read by apps/web (the OAuth consent page). Comma-separated hosts an OAuth
# client may send the editor to after approval; an exact hostname, or *.example.com for
# subdomains. HTTPS only, plain HTTP only on loopback. Setting it REPLACES the default,
# which is claude.ai, claude.com, chatgpt.com, localhost, 127.0.0.1 and [::1].
ATLASNEWS_OAUTH_REDIRECT_HOSTS=

# Name of the ONE request header that carries the client's IP address, set by the edge in
# front of the site and of apps/mcp (for example cf-connecting-ip behind Cloudflare). Used
# for the per-network rate limits of comments, newsletter requests and events/subscribe.
# Leave empty unless that edge overwrites the header on every request: any other header can
# be set by the client. Empty means no network identity is derived from the request (the
# per-network limits then do not bind; see docs/DEPLOYMENT.md). No fallback to other headers.
ATLASNEWS_CLIENT_IP_HEADER=

# Optional MCP Events (ChatGPT subscriptions) limits, read by apps/mcp. Defaults in brackets.
# Live subscriptions per callback hostname [25], per registrable domain [100], in total [1000],
# and accepted events/subscribe calls per minute per client network [30].
ATLASNEWS_MCP_EVENTS_MAX_PER_HOST=
ATLASNEWS_MCP_EVENTS_MAX_PER_DOMAIN=
ATLASNEWS_MCP_EVENTS_MAX_SUBSCRIPTIONS=
ATLASNEWS_MCP_EVENTS_SUBSCRIBES_PER_MINUTE=

# Optional comma-separated browser origins allowed to call the public MCP route.
# Empty means wildcard CORS for this read-only endpoint. Non-browser clients
# commonly omit Origin and remain supported.
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Optional, read by apps/mcp. OpenAI domain verification for plugin submission: the server
# answers GET /.well-known/openai-apps-challenge with this token as plain text, and 404 while
# it is unset. One line of printable ASCII without spaces, 8 to 256 characters.
ATLASNEWS_OPENAI_APPS_CHALLENGE=

# Optional, read by apps/mcp. Dedicated https origin of the hosted UI, sent as
# `_meta.ui.domain`. OpenAI requires it for a plugin that ships UI, and it must be unique to
# that plugin. Origin only, for example https://ui.news.example.com: no path, query or
# fragment. Empty leaves the metadata unchanged; an invalid value is ignored.
ATLASNEWS_MCP_UI_DOMAIN=

# High-entropy Bearer credential for the newsroom tools of POST /mcp, for CI and
# the self-hosted CLI (minimum 32 characters; read by apps/mcp). Editors sign in
# with Supabase Auth instead and are attributed to their own author; this key is
# attributed to ATLASNEWS_MCP_ADMIN_AUTHOR_ID.
# Generate with: openssl rand -hex 32
ATLASNEWS_MCP_ADMIN_API_KEY=

# Shared secret between apps/mcp and apps/web (minimum 32 characters; set the SAME
# value on both). After an editorial write apps/mcp calls POST /api/revalidate on
# the site with it, and apps/web answers 503 to everyone while it is unset.
# Generate with: openssl rand -hex 32
ATLASNEWS_REVALIDATE_SECRET=

# Real operational capabilities. Production health stays not-ready until every
# capability below is configured; local demo mode never simulates these writes.
# Generate independent random values for each secret with `openssl rand -hex 32`.
# CRON_SECRET guards the /internal/* job routes. On Sites the Worker also runs due jobs
# itself after requests, so it is only needed for an external schedule.
CRON_SECRET=
ATLASNEWS_COMMENT_GUEST_SECRET=

# Resend newsletter and comment-notification delivery. Verify the sender domain
# and register /api/webhooks/newsletter as a signed webhook endpoint.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO=
NEWSLETTER_UNSUBSCRIBE_SECRET=

# LinkedIn Posts API. The author is a person or organization URN. Keep the API
# version explicit (YYYYMM) so deprecations fail visibly instead of drifting.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202604

# X API v2 user-context token with permission to create posts.
X_USER_ACCESS_TOKEN=

# WhatsApp Cloud API. WHATSAPP_API_VERSION must be an enabled Graph version,
# for example v24.0; recipients are supplied explicitly per queued message.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
