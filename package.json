{
  "name": "atlasnews",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @atlasnews/web dev",
    "build": "pnpm --filter @atlasnews/web build:next",
    "build:sites": "pnpm --filter @atlasnews/web build && pnpm --filter @atlasnews/web typegen",
    "start": "pnpm --filter @atlasnews/web start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "design:lint": "designmd lint --format json DESIGN.md",
    "design:tokens:write": "node scripts/design-tokens.mjs --write",
    "design:tokens:check": "node scripts/design-tokens.mjs",
    "plugin:check": "node scripts/validate-plugin.mjs",
    "plugin:release": "node scripts/validate-plugin.mjs --release",
    "perf:budget": "node scripts/performance-budget.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status",
    "check": "export NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-http://localhost:3000} && pnpm run design:lint && pnpm run design:tokens:check && pnpm run plugin:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run perf:budget && pnpm run build:sites"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
