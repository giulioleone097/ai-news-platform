{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "atlasnews": {
      "type": "streamable-http",
      "url": "http://localhost:8787/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "email"
            ]
          }
        }
      }
    }
  }
}
